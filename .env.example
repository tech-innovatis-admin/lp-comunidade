# Configuração do Banco de Dados PostgreSQL (RDS AWS)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# Configuração AWS S3 para upload de documentos
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Configuração Google Sheets (Sincronização de Inscrições)
# 
# OPÇÃO 1 (RECOMENDADO - como no projeto Python): Buscar JSON do S3
GOOGLE_CREDENTIALS_S3_BUCKET=
GOOGLE_CREDENTIALS_S3_KEY=
GOOGLE_CREDENTIALS_S3_REGION=
GOOGLE_SHEET_NAME=
# OU use GOOGLE_SHEET_ID se preferir usar ID direto (ex: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms)
# GOOGLE_SHEET_ID=seu-id-da-planilha
#
# OPÇÃO 2: JSON completo em variável de ambiente (todo o conteúdo do arquivo JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
#
# OPÇÃO 3: Variáveis individuais (fallback)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL pública da aplicação
PUBLIC_BASE_URL=

# Webhook N8N exclusivo da inscrição na comunidade (não usar para propostas do Edital)
WEBHOOK_N8N_URL=

# Webhook N8N exclusivo da confirmação de proposta do Edital (não usar o de inscrição)
WEBHOOK_N8N_EDITAL_URL=

# Modo de teste: desativa a checagem de email/CPF duplicados
# BYPASS_DUPLICATE_CHECKS=true

# [DEPRECATED] Variáveis legadas do fluxo WhatsApp (não mais usadas)
# WHATSAPP_GROUP_INVITE_URL=
# NEXT_PUBLIC_LANDING_VARIANT=MANUAL
# INVITE_ONE_TIME_USE=true
